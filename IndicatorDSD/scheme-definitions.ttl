#################################################################
# South African Economic Age Category Scheme (as per issue example)
#################################################################

ind:ZAEconomicAgeCategoryScheme_v1 a skos:ConceptScheme ;
  skos:prefLabel "South Africa: economic/legal age categories v1"@en ;
  ind:definitionVersion "1.0" ;
  skos:note "This is a platform scheme for local indicator reporting. If you require strict legal alignment for sex-dependent thresholds, enforce it in validation rules or publish a v2 scheme with sex-specific concepts."@en ;
  skos:hasTopConcept ind:za_age_child_u18 , ind:za_age_working_15_64 , ind:za_age_older_60plus .

ind:za_age_child_u18 a skos:Concept ;
  skos:prefLabel "Child (<18)"@en ;
  skos:inScheme ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:topConceptOf ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:notation "CHILD_U18" .

ind:za_age_working_15_64 a skos:Concept ;
  skos:prefLabel "Working-age (15–64)"@en ;
  skos:inScheme ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:topConceptOf ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:notation "WORK_15_64" .

ind:za_age_older_60plus a skos:Concept ;
  skos:prefLabel "Older (60+)"@en ;
  skos:inScheme ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:topConceptOf ind:ZAEconomicAgeCategoryScheme_v1 ;
  skos:notation "OLDER_60P" .

#################################################################
# Global Age Scheme (for international SDG indicators)
#################################################################

ind:GlobalAgeScheme_v1 a skos:ConceptScheme ;
  skos:prefLabel "Global age categories v1"@en ;
  ind:definitionVersion "1.0" ;
  skos:note "Standard age groupings for international comparison, commonly used in SDG indicators."@en ;
  skos:hasTopConcept ind:age_0_4 , ind:age_5_9 , ind:age_10_14 , 
                     ind:age_15_19 , ind:age_20_24 , ind:age_25_29 ,
                     ind:age_30_34 , ind:age_35_39 , ind:age_40_44 ,
                     ind:age_45_49 , ind:age_50_54 , ind:age_55_59 ,
                     ind:age_60_64 , ind:age_65_plus .

ind:age_0_4 a skos:Concept ;
  skos:prefLabel "0-4 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_0_4" .

ind:age_5_9 a skos:Concept ;
  skos:prefLabel "5-9 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_5_9" .

ind:age_10_14 a skos:Concept ;
  skos:prefLabel "10-14 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_10_14" .

ind:age_15_19 a skos:Concept ;
  skos:prefLabel "15-19 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_15_19" .

ind:age_20_24 a skos:Concept ;
  skos:prefLabel "20-24 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_20_24" .

ind:age_25_29 a skos:Concept ;
  skos:prefLabel "25-29 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_25_29" .

ind:age_30_34 a skos:Concept ;
  skos:prefLabel "30-34 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_30_34" .

ind:age_35_39 a skos:Concept ;
  skos:prefLabel "35-39 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_35_39" .

ind:age_40_44 a skos:Concept ;
  skos:prefLabel "40-44 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_40_44" .

ind:age_45_49 a skos:Concept ;
  skos:prefLabel "45-49 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_45_49" .

ind:age_50_54 a skos:Concept ;
  skos:prefLabel "50-54 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_50_54" .

ind:age_55_59 a skos:Concept ;
  skos:prefLabel "55-59 years"@en ;
  skos:inScheme ind:GlobalAgeScheme_v1 ;
  skos:topConceptOf ind:GlobalAgeScheme_v1 ;
  skos:notation "AGE_55_59" .

ind:age_60_64 a skos:Concept ;
