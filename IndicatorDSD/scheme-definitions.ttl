#################################################################
# Administrative Unit Scheme (placeholder for geographic disaggregation)
#################################################################

ind:AdminUnitScheme_v1 a skos:ConceptScheme ;
  skos:prefLabel "Administrative unit scheme v1"@en ;
  ind:definitionVersion "1.0" ;
  skos:note "Placeholder scheme for administrative geographic units. In practice, this would reference a specific geographic classification system (e.g., ISO 3166, national admin boundaries)."@en ;
  skos:hasTopConcept ind:admin_national , ind:admin_regional , ind:admin_local .

ind:admin_national a skos:Concept ;
  skos:prefLabel "National level"@en ;
  skos:inScheme ind:AdminUnitScheme_v1 ;
  skos:topConceptOf ind:AdminUnitScheme_v1 ;
  skos:notation "NATIONAL" ;
  skos:definition "Data aggregated at the national/country level."@en .

ind:admin_regional a skos:Concept ;
  skos:prefLabel "Regional level"@en ;
  skos:inScheme ind:AdminUnitScheme_v1 ;
  skos:topConceptOf ind:AdminUnitScheme_v1 ;
  skos:notation "REGIONAL" ;
  skos:definition "Data aggregated at the regional/provincial/state level."@en .

ind:admin_local a skos:Concept ;
  skos:prefLabel "Local level"@en ;
  skos:inScheme ind:AdminUnitScheme_v1 ;
  skos:topConceptOf ind:AdminUnitScheme_v1 ;
  skos:notation "LOCAL" ;
  skos:definition "Data aggregated at the local/municipal/district level."@en .

