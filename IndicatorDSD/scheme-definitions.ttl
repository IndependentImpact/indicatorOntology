#################################################################
# Income Quintile Scheme
#################################################################

ind:IncomeQuintileScheme_v1 a skos:ConceptScheme ;
  skos:prefLabel "Income quintile scheme v1"@en ;
  ind:definitionVersion "1.0" ;
  skos:hasTopConcept ind:quintile_1 , ind:quintile_2 , 
                     ind:quintile_3 , ind:quintile_4 , ind:quintile_5 .

ind:quintile_1 a skos:Concept ;
  skos:prefLabel "Quintile 1 (poorest 20%)"@en ;
  skos:inScheme ind:IncomeQuintileScheme_v1 ;
  skos:topConceptOf ind:IncomeQuintileScheme_v1 ;
  skos:notation "Q1" .

ind:quintile_2 a skos:Concept ;
  skos:prefLabel "Quintile 2"@en ;
  skos:inScheme ind:IncomeQuintileScheme_v1 ;
