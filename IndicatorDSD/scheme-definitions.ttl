ind:quintile_3 a skos:Concept ;
  skos:prefLabel "Quintile 3"@en ;
  skos:inScheme ind:IncomeQuintileScheme_v1 ;
  skos:topConceptOf ind:IncomeQuintileScheme_v1 ;
  skos:notation "Q3" .

ind:quintile_4 a skos:Concept ;
  skos:prefLabel "Quintile 4"@en ;
  skos:inScheme ind:IncomeQuintileScheme_v1 ;
  skos:topConceptOf ind:IncomeQuintileScheme_v1 ;
  skos:notation "Q4" .

ind:quintile_5 a skos:Concept ;
  skos:prefLabel "Quintile 5 (richest 20%)"@en ;
  skos:inScheme ind:IncomeQuintileScheme_v1 ;
  skos:topConceptOf ind:IncomeQuintileScheme_v1 ;
  skos:notation "Q5" .

