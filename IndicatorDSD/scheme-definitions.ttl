@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# Sex Scheme (as per issue example)
#################################################################

ind:SexScheme_v1 a skos:ConceptScheme ;
  skos:prefLabel "Sex scheme v1"@en ;
  ind:definitionVersion "1.0" ;
  skos:hasTopConcept ind:sex_female , ind:sex_male , 
                     ind:sex_other , ind:sex_unknown .

ind:sex_female a skos:Concept ;
  skos:prefLabel "Female"@en ;
  skos:inScheme ind:SexScheme_v1 ;
  skos:topConceptOf ind:SexScheme_v1 ;
  skos:notation "F" .

ind:sex_male a skos:Concept ;
  skos:prefLabel "Male"@en ;
  skos:inScheme ind:SexScheme_v1 ;
  skos:topConceptOf ind:SexScheme_v1 ;
  skos:notation "M" .

ind:sex_other a skos:Concept ;
  skos:prefLabel "Other / non-binary"@en ;
  skos:inScheme ind:SexScheme_v1 ;
  skos:topConceptOf ind:SexScheme_v1 ;
  skos:notation "X" .

ind:sex_unknown a skos:Concept ;
  skos:prefLabel "Unknown / not stated"@en ;
  skos:inScheme ind:SexScheme_v1 ;
  skos:topConceptOf ind:SexScheme_v1 ;
  skos:notation "U" .

#################################################################
