  <rdf:Description rdf:about="http://independentimpact.org/indicator-owl/hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n734c2afe93f14699a9d7c4f44bc4d341b4"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:label xml:lang="en">has unit of measure</rdfs:label>
    <rdfs:comment xml:lang="en">Connects indicators and indicator values to the QUDT unit that governs their interpretation; keep the UCUM code on the unit individual for machine-to-machine exchange.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://independentimpact.org/indicator-owl/AxisRole">
