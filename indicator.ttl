@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:       <http://purl.org/dc/terms/> .
@prefix foaf:      <http://xmlns.com/foaf/0.1/> .
@prefix ind:     <http://independentimpact.org/indicator-owl/> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix aiao:      <http://w3id.org/aiao#> .
@prefix claimont:  <http://w3id.org/claimont#> .
@prefix impact:    <http://w3id.org/impactont#> .
@prefix infocomm:  <http://w3id.org/infocomm#> .
@prefix qudt:      <http://qudt.org/schema/qudt/> .
@prefix unit:      <http://qudt.org/vocab/unit/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix time:      <http://www.w3.org/2006/time#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

ind: a owl:Ontology ;
  dct:title "Indicator OWL prototype aligned with AIAO, ClaimOnt, ImpactOnt, and InfoComm"@en ;
  dct:description "Ontology for expressing indicator semantics, providing OWL descriptions aligned with aiao, claimont, impactont, and infocomm. While originally developed for SDG indicators, this ontology has general applicability to any indicator framework."@en ;
  dct:source <https://w3id.org/aiao> ;
  dct:source <https://w3id.org/claimont> ;
  dct:source <https://w3id.org/impactont> ;
  dct:source <http://w3id.org/infocomm> .

# -- Impact pathway stages for indicators (SKOS classification) --
ind:IndicatorStageScheme a skos:ConceptScheme ;
  skos:prefLabel "Indicator stages in an impact pathway"@en ;
  skos:definition "Stages used to categorise indicators along a theory of change from activities through outputs, outcomes, and impacts."@en ;
  skos:hasTopConcept ind:ActivityIndicator , ind:OutputIndicator , ind:OutcomeIndicator , ind:ImpactIndicator .

ind:ActivityIndicator a skos:Concept ;
  skos:prefLabel "Activity indicator"@en ;
  skos:definition "Indicator that measures activities performed within an intervention."@en ;
  skos:inScheme ind:IndicatorStageScheme ;
  skos:topConceptOf ind:IndicatorStageScheme .

ind:OutputIndicator a skos:Concept ;
  skos:prefLabel "Output indicator"@en ;
  skos:definition "Indicator that measures immediate deliverables or services produced by an intervention."@en ;
  skos:inScheme ind:IndicatorStageScheme ;
  skos:topConceptOf ind:IndicatorStageScheme .

ind:OutcomeIndicator a skos:Concept ;
  skos:prefLabel "Outcome indicator"@en ;
  skos:definition "Indicator that measures short- to medium-term changes experienced by people or systems."@en ;
  skos:inScheme ind:IndicatorStageScheme ;
  skos:topConceptOf ind:IndicatorStageScheme .

ind:ImpactIndicator a skos:Concept ;
  skos:prefLabel "Impact indicator"@en ;
  skos:definition "Indicator that measures long-term, higher-level changes attributable to an intervention or strategy."@en ;
  skos:inScheme ind:IndicatorStageScheme ;
  skos:topConceptOf ind:IndicatorStageScheme .

# -- Core prototype classes (aligned to external ontologies) --
ind:IndicatorDefinition a owl:Class ;
  rdfs:subClassOf impact:Indicator , infocomm:Information ;
  rdfs:label "Indicator definition"@en ;
  skos:definition "An indicator concept that contains descriptive metadata, expected units, and rationale."@en ;
  rdfs:comment "Provides operational semantics for indicators. Can be linked from external indicator catalogues (such as SDG SKOS indicators) via foaf:focus."@en .

ind:IndicatorFormula a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Indicator formula"@en ;
  skos:definition "A human-readable description of how to compute an indicator value."@en .

ind:Symbol a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Symbol"@en ;
  skos:definition "A symbolic placeholder used within an indicator formula or expression."@en ;
  rdfs:comment "Use for mathematical or statistical symbols that appear in indicator expressions; attach foaf:focus to the underlying quantity or concept and a unit via ind:hasUnit."@en .

ind:MathOperator a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Mathematical operator"@en ;
  skos:definition "An operator token (e.g., =, +, -, *, /, ^) used to relate symbols in an indicator expression."@en ;
  rdfs:comment "Distinguishes symbolic operators from physical operators or agents; use skos:prefLabel for the glyph and rdfs:comment for usage examples."@en .

ind:IndicatorRationale a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Indicator rationale"@en ;
  skos:definition "Narrative justification for why the indicator is relevant to the objective or state being monitored."@en .

ind:MeasuredIndicatorValue a owl:Class ;
  rdfs:subClassOf impact:IndicatorValue ;
  rdfs:label "Measured indicator value"@en ;
  skos:definition "An indicator value obtained directly from observation, monitoring, sampling, or metering."@en .

ind:DerivedIndicatorValue a owl:Class ;
  rdfs:subClassOf impact:IndicatorValue ;
  rdfs:label "Derived indicator value"@en ;
  skos:definition "An indicator value computed or inferred from other indicator values, variables, or constants."@en .

ind:MeasuredIndicatorValue owl:disjointWith ind:DerivedIndicatorValue .

# -- Object properties --
ind:hasFormula a owl:ObjectProperty ;
  rdfs:domain impact:Indicator ;
  rdfs:range ind:IndicatorFormula ;
  rdfs:label "has formula"@en ;
  rdfs:comment "Connects an indicator to its computation description."@en .

ind:hasExpression a owl:ObjectProperty ;
  rdfs:subPropertyOf ind:hasFormula ;
  rdfs:domain impact:Indicator ;
  rdfs:range ind:IndicatorFormula ;
  rdfs:label "has expression"@en ;
  rdfs:comment "Alias for ind:hasFormula to preserve existing data that refers to an expression node; prefer ind:hasFormula going forward while keeping expressionText and symbol/operator listings inside the formula resource."@en .

ind:usesSymbol a owl:ObjectProperty ;
  rdfs:domain ind:IndicatorFormula ;
  rdfs:range ind:Symbol ;
  rdfs:label "uses symbol"@en ;
  rdfs:comment "Enumerates the symbols that participate in an indicator expression; attach units to symbols via ind:hasUnit and use foaf:focus to point to the underlying quantity or constant."@en .

ind:usesOperator a owl:ObjectProperty ;
  rdfs:domain ind:IndicatorFormula ;
  rdfs:range ind:MathOperator ;
  rdfs:label "uses operator"@en ;
  rdfs:comment "Enumerates mathematical operators present in an indicator expression (e.g., equality, multiplication, division, exponentiation)."@en .

ind:hasIndicatorStage a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( impact:Indicator skos:Concept ) ] ;
  rdfs:range skos:Concept ;
  rdfs:label "has indicator stage"@en ;
  rdfs:comment "Categorises an indicator according to the stage it occupies within an impact pathway (activity, output, outcome, or impact); usable on indicator definitions and the SKOS indicator catalogue entries that reference them."@en .

ind:hasUnit a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( impact:Indicator impact:IndicatorValue ) ] ;
  rdfs:range qudt:Unit ;
  rdfs:label "has unit of measure"@en ;
  rdfs:comment "Connects indicators and indicator values to the QUDT unit that governs their interpretation; keep the UCUM code on the unit individual for machine-to-machine exchange."@en .

ind:hasRationale a owl:ObjectProperty ;
  rdfs:domain impact:Indicator ;
  rdfs:range ind:IndicatorRationale ;
  rdfs:label "has rationale"@en ;
  rdfs:comment "Connects an indicator to an explanation of its purpose."@en .

ind:hasDefaultDSD a owl:ObjectProperty ;
  rdfs:domain ind:IndicatorDefinition ;
  rdfs:range ind:DataStructureDefinition ;
  rdfs:label "has default DSD"@en ;
  rdfs:comment "Links an indicator definition to its recommended data structure definition. Organizations may define additional DSDs for context-specific reporting."@en .

ind:reportsIndicator a owl:ObjectProperty ;
  rdfs:domain claimont:Report ;
  rdfs:range impact:Indicator ;
  rdfs:label "reports indicator"@en ;
  rdfs:comment "Links a claim report to the indicator definition it reports on."@en .

ind:communicatedBy a owl:ObjectProperty ;
  rdfs:domain claimont:Report ;
  rdfs:range infocomm:CommunicationEvent ;
  rdfs:label "communicated by"@en ;
  rdfs:comment "Associates an indicator report with the communication event that transmits it."@en .

# -- Datatype properties and supporting datatypes --
ind:expressionText a owl:DatatypeProperty ;
  rdfs:domain ind:IndicatorFormula ;
  rdfs:range xsd:string ;
  rdfs:label "expression text"@en ;
  rdfs:comment "Canonical string for the expression; pair with ind:mathTextRepresentationType to declare whether the syntax is LaTeX, AsciiMath, or Content MathML."@en .

ind:MathTextNotation a rdfs:Datatype ;
  owl:oneOf ( "LaTeX"^^xsd:string "AsciiMath"^^xsd:string "ContentMathML"^^xsd:string ) ;
  rdfs:label "math text notation"@en ;
  rdfs:comment "Controlled enumeration of math text serialization types allowed for ind:mathTextRepresentationType."@en .

ind:mathTextRepresentationType a owl:DatatypeProperty ;
  rdfs:domain ind:IndicatorFormula ;
  rdfs:range ind:MathTextNotation ;
  rdfs:label "math text representation type"@en ;
  rdfs:comment "Identifies the notation used in ind:expressionText (restricted to 'LaTeX', 'AsciiMath', or 'ContentMathML'); useful for rendering and parsing."@en .

#################################################################
#  A) Data Structure Definition (DSD) as a "Control / Schema"
#################################################################

ind:DataStructureDefinition a owl:Class ;
  rdfs:subClassOf aiao:Control , infocomm:Information ;
  rdfs:label "Data Structure Definition"@en ;
  skos:definition "A specification of the axes (dimensions), measures and attributes used to report observations for an indicator/series family."@en ;
  rdfs:comment "SDMX-inspired: this describes structure; it does not contain values."@en .

ind:Axis a owl:Class ;
  rdfs:subClassOf aiao:Control , infocomm:Information ;
  rdfs:label "Axis"@en ;
  skos:definition "A typed classification axis used to disaggregate or qualify observations (e.g., sex, legal age category, land use type)."@en .

ind:AxisRole a owl:Class ;
  rdfs:label "Axis role"@en ;
  skos:definition "Role played by an axis in a structure: dimension, measure, or attribute."@en .

ind:DimensionRole a ind:AxisRole ; rdfs:label "Dimension"@en .
ind:MeasureRole   a ind:AxisRole ; rdfs:label "Measure"@en .
ind:AttributeRole a ind:AxisRole ; rdfs:label "Attribute"@en .

ind:AxisSpecification a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Axis specification"@en ;
  skos:definition "Connects a DSD to an Axis and declares its role, expected value scheme, and cardinality."@en .

ind:hasAxisSpec a owl:ObjectProperty ;
  rdfs:domain ind:DataStructureDefinition ;
  rdfs:range  ind:AxisSpecification ;
  rdfs:label "has axis specification"@en .

ind:axis a owl:ObjectProperty ;
  rdfs:domain ind:AxisSpecification ;
  rdfs:range  ind:Axis ;
  rdfs:label "axis"@en .

ind:axisRole a owl:ObjectProperty ;
  rdfs:domain ind:AxisSpecification ;
  rdfs:range  ind:AxisRole ;
  rdfs:label "axis role"@en .

ind:valueScheme a owl:ObjectProperty ;
  rdfs:domain ind:AxisSpecification ;
  rdfs:range  skos:ConceptScheme ;
  rdfs:label "value scheme"@en ;
  rdfs:comment "The SKOS ConceptScheme enumerating allowable values for this axis."@en .

ind:minCardinality a owl:DatatypeProperty ;
  rdfs:domain ind:AxisSpecification ;
  rdfs:range  xsd:integer ;
  rdfs:label "min cardinality"@en .

ind:maxCardinality a owl:DatatypeProperty ;
  rdfs:domain ind:AxisSpecification ;
  rdfs:range  xsd:integer ;
  rdfs:label "max cardinality"@en ;
  rdfs:comment "Use -1 to mean unbounded / repeatable."@en .


#################################################################
#  B) Indicator value reporting context
#################################################################

ind:usesDSD a owl:ObjectProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  ind:DataStructureDefinition ;
  rdfs:label "uses DSD"@en .

ind:refArea a owl:ObjectProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  prov:Location ;
  rdfs:label "reference area"@en ;
  rdfs:comment "Town, group of towns, biome, catchment, admin unit, etc."@en .

ind:reportingPeriod a owl:ObjectProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  time:Interval ;
  rdfs:label "reporting period"@en ;
  rdfs:comment "Reporting period for the indicator value; modeled as a time:Interval."@en .

ind:obsStatus a owl:ObjectProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  skos:Concept ;
  rdfs:label "observation status"@en ;
  rdfs:comment "Status concept for the indicator value (e.g., REPORTED, ESTIMATED, IMPUTED, PROVISIONAL)."@en .

ind:methodReference a owl:DatatypeProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  xsd:anyURI ;
  rdfs:label "method reference"@en .


#################################################################
#  C) Repeatable subgroup disaggregation (Axis–Scheme architecture)
#################################################################

ind:SubgroupSlice a owl:Class ;
  rdfs:subClassOf infocomm:Information ;
  rdfs:label "Subgroup slice"@en ;
  skos:definition "A repeatable (axis, value) pair that attaches one disaggregation category (e.g., sex=female) to an indicator value instance."@en .

ind:hasSubgroupSlice a owl:ObjectProperty ;
  rdfs:domain impact:IndicatorValue ;
  rdfs:range  ind:SubgroupSlice ;
  rdfs:label "has subgroup slice"@en .

ind:subgroupAxis a owl:ObjectProperty ;
  rdfs:domain ind:SubgroupSlice ;
  rdfs:range  ind:Axis ;
  rdfs:label "subgroup axis"@en .

ind:subgroupValue a owl:ObjectProperty ;
  rdfs:domain ind:SubgroupSlice ;
  rdfs:range  skos:Concept ;
  rdfs:label "subgroup value"@en ;
  rdfs:comment "Must be a concept in the axis' declared skos:ConceptScheme (via ind:valueScheme on the AxisSpecification)."@en .











